JOBBOT_ENV=development
JOBBOT_DB_PATH=data/jobbot.db
JOBBOT_DATA_DIR=data
JOBBOT_LOG_DIR=logs
JOBBOT_SCREENSHOT_DIR=screenshots
JOBBOT_BROWSER_VISIBLE=true
JOBBOT_BROWSER_HEADLESS=false
JOBBOT_LLM_PROVIDER=ollama
JOBBOT_LLM_BASE_URL=http://localhost:11434/v1
JOBBOT_LLM_MODEL=llama3.2
JOBBOT_OPENAI_API_KEY=
JOBBOT_OPENAI_BASE_URL=
JOBBOT_ALLOW_REMOTE_LLM=false
JOBBOT_REVIEW_THRESHOLD=0.72
JOBBOT_AUTOFILL_SENSITIVE=false
