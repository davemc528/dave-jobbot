{
  "manifest_version": 3,
  "name": "Dave Jobbot",
  "version": "0.1.0",
  "description": "Local, supervised job capture and verified application assistance.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dave Jobbot"
  }
}
